  implicationCounterexample[T_Operationalization, T_Evidence] // C11
  implicationCounterexample[T_Truth, T_Evidence] // C14
  implicationCounterexample[T_Evidence, T_Truth] // C14
  implicationCounterexample[T_Truth, T_Admission] // C14
  implicationCounterexample[T_Admission, T_Truth] // C14
