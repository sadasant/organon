  implicationCounterexample[T_MoralPersonhoodDesignation, T_Person] // C21
  implicationCounterexample[T_MoralPersonhoodDesignation, T_Standing] // C21
  implicationCounterexample[T_MoralPersonhoodDesignation, T_Permission] // C21
  implicationCounterexample[T_MoralPersonhoodDesignation, T_Consequence] // C21
